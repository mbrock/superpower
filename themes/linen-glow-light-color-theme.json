{
  "name": "Linen Glow Light",
  "type": "light",
  "colors": {
    "editor.foreground": "#130900",
    "foreground": "#130900",
    "terminal.foreground": "#130900",
    "editorCursor.foreground": "#130900",
    "editorLineNumber.foreground": "#7c7057",
    "editorLineNumber.activeForeground": "#372c15",
    "list.activeSelectionForeground": "#00006b",
    "list.inactiveSelectionForeground": "#00006b",
    "list.hoverForeground": "#130900",
    "statusBar.foreground": "#130900",
    "editor.background": "#ffffff",
    "terminal.background": "#ffffff",
    "sideBar.background": "#e8e8e8",
    "activityBar.background": "#e8e8e8",
    "panel.background": "#e8e8e8",
    "tab.inactiveBackground": "#e8e8e8",
    "tab.activeBackground": "#ffffff",
    "statusBar.background": "#d1d1d1",
    "titleBar.activeBackground": "#d1d1d1",
    "input.background": "#d1d1d1",
    "dropdown.background": "#d1d1d1",
    "list.hoverBackground": "#d1d1d1",
    "button.background": "#3a000073",
    "errorForeground": "#510000",
    "editorError.foreground": "#510000",
    "terminal.ansiRed": "#510000",
    "editorWarning.foreground": "#3a0000",
    "terminal.ansiYellow": "#3a0000",
    "editorInfo.foreground": "#00006b",
    "terminal.ansiBlue": "#00006b",
    "terminal.ansiCyan": "#00006b",
    "terminal.ansiGreen": "#002700",
    "terminal.ansiMagenta": "#37004b",
    "gitDecoration.untrackedResourceForeground": "#002700",
    "gitDecoration.modifiedResourceForeground": "#3a0000",
    "gitDecoration.deletedResourceForeground": "#510000",
    "gitDecoration.conflictingResourceForeground": "#37004b",
    "focusBorder": "#3a0000",
    "list.focusOutline": "#3a0000",
    "list.focusHighlightForeground": "#3a0000",
    "editorBracketMatch.border": "#002700",
    "editor.selectionBackground": "#00006b4d",
    "list.activeSelectionBackground": "#00006b4d",
    "list.inactiveSelectionBackground": "#00006b4d",
    "editor.wordHighlightBackground": "#00006b26",
    "editor.findMatchBackground": "#3a000073",
    "editor.findMatchHighlightBackground": "#3a000073",
    "editorBracketMatch.background": "#00270026"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#1e1400",
        "fontStyle": "bold"
      }
    },
    {
      "name": "doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#4c0000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#1e1400"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#00006b"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#3a0000"
      }
    },
    {
      "name": "interpolation",
      "scope": [
        "string.interpolated",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#002a10"
      }
    },
    {
      "name": "regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#002631"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#510000"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#3a0000"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#3a0000"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000361"
      }
    },
    {
      "name": "interface",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#002a10"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#1e1400"
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#3a0000"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#002700"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#3a0000"
      }
    },
    {
      "name": "decorator",
      "scope": [
        "meta.decorator",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#3a0000"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#37004b"
      }
    },
    {
      "name": "special var",
      "scope": [
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#37004b"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#510000"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": {
      "foreground": "#00006b"
    },
    "method": {
      "foreground": "#00006b"
    },
    "function.declaration": {
      "foreground": "#00006b",
      "bold": true
    },
    "method.declaration": {
      "foreground": "#00006b",
      "bold": true
    },
    "variable": {
      "foreground": "#3a0000"
    },
    "parameter": {
      "foreground": "#3a0000"
    },
    "type": {
      "foreground": "#000361"
    },
    "class": {
      "foreground": "#000361"
    },
    "namespace": {
      "foreground": "#000361"
    },
    "enum": {
      "foreground": "#000361"
    },
    "interface": {
      "foreground": "#002a10"
    },
    "typeParameter": {
      "foreground": "#002a10"
    },
    "property": {
      "foreground": "#3a0000"
    }
  }
}
