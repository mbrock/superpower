{
  "name": "Linen Glow Light",
  "type": "light",
  "colors": {
    "editor.background": "#fffafc",
    "editor.foreground": "#2a1e21",
    "editorCursor.foreground": "#2a1e21",
    "editorLineNumber.foreground": "#636363",
    "editorLineNumber.activeForeground": "#bb1664",
    "editor.selectionBackground": "#f4efff66",
    "editor.wordHighlightBackground": "#f4efff40",
    "editor.findMatchBackground": "#9a730066",
    "editor.findMatchHighlightBackground": "#9a730033",
    "editorBracketMatch.background": "#00934233",
    "editorBracketMatch.border": "#009342",
    "focusBorder": "#9a730080",
    "foreground": "#2a1e21",
    "errorForeground": "#e50026",
    "editorError.foreground": "#e50026",
    "editorWarning.foreground": "#9a7300",
    "editorInfo.foreground": "#007dd6",
    "gitDecoration.modifiedResourceForeground": "#9a7300",
    "gitDecoration.deletedResourceForeground": "#e50026",
    "gitDecoration.untrackedResourceForeground": "#009342",
    "gitDecoration.conflictingResourceForeground": "#bc00dc",
    "terminal.foreground": "#2a1e21",
    "terminal.background": "#fffafc",
    "terminal.ansiRed": "#e50026",
    "terminal.ansiGreen": "#009342",
    "terminal.ansiYellow": "#9a7300",
    "terminal.ansiBlue": "#007dd6",
    "terminal.ansiMagenta": "#bc00dc",
    "terminal.ansiCyan": "#008c8c",
    "activityBar.background": "#f5ecee",
    "sideBar.background": "#fbf2f5",
    "statusBar.background": "#e4dbde",
    "titleBar.activeBackground": "#f5ecee",
    "tab.activeBackground": "#fffafc",
    "tab.inactiveBackground": "#f5ecee",
    "panel.background": "#fbf2f5",
    "input.background": "#ffffff",
    "dropdown.background": "#ffffff",
    "list.activeSelectionBackground": "#f4efff4d",
    "list.hoverBackground": "#f5ecee",
    "button.background": "#9a7300",
    "button.foreground": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9a7300",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "comment.block.documentation punctuation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#b95e00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#009342",
        "background": "#cbfff066"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#007dd6",
        "background": "#f4efff40"
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.function entity.name.function"
      ],
      "settings": {
        "foreground": "#007dd6",
        "fontStyle": "bold",
        "background": "#f4efff4d"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#008c8c"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "string.interpolated",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#008f77"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex"
      ],
      "settings": {
        "foreground": "#e50026"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#b95e00",
        "background": "#fff0d226"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2a1e21",
        "background": "#fff0d214"
      }
    },
    {
      "name": "Special variables",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#bc00dc"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.module",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#00729f",
        "background": "#cbfff026"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#008f77",
        "background": "#cbfff01f"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#bb1664",
        "background": "#fff0d20d"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#636363"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#636363"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#009342"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9a7300"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9832ff"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#bc00dc"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e50026",
        "background": "#e5002633"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#9a7300"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": {
      "foreground": "#007dd6"
    },
    "method": {
      "foreground": "#007dd6"
    },
    "function.declaration": {
      "foreground": "#007dd6",
      "bold": true
    },
    "method.declaration": {
      "foreground": "#007dd6",
      "bold": true
    },
    "variable.readonly": {
      "foreground": "#b95e00"
    },
    "property.readonly": {
      "foreground": "#b95e00"
    },
    "enumMember": {
      "foreground": "#b95e00"
    },
    "variable": {
      "foreground": "#2a1e21"
    },
    "parameter": {
      "foreground": "#2a1e21"
    },
    "type": {
      "foreground": "#00729f"
    },
    "class": {
      "foreground": "#00729f"
    },
    "namespace": {
      "foreground": "#00729f"
    },
    "enum": {
      "foreground": "#00729f"
    },
    "interface": {
      "foreground": "#008f77"
    },
    "typeParameter": {
      "foreground": "#008f77"
    },
    "property": {
      "foreground": "#bb1664"
    }
  }
}
