{
  "name": "Linen Glow",
  "type": "dark",
  "colors": {
    "editor.foreground": "#f5eee0",
    "foreground": "#f5eee0",
    "terminal.foreground": "#f5eee0",
    "editorCursor.foreground": "#f5eee0",
    "editorLineNumber.foreground": "#5a5549",
    "editorLineNumber.activeForeground": "#a49e91",
    "list.activeSelectionForeground": "#3fc3ff",
    "list.inactiveSelectionForeground": "#3fc3ff",
    "list.hoverForeground": "#f5eee0",
    "statusBar.foreground": "#f5eee0",
    "editor.background": "#000000",
    "terminal.background": "#000000",
    "sideBar.background": "#020100",
    "activityBar.background": "#020100",
    "panel.background": "#020100",
    "tab.inactiveBackground": "#020100",
    "tab.activeBackground": "#000000",
    "statusBar.background": "#0d0802",
    "titleBar.activeBackground": "#0d0802",
    "input.background": "#0d0802",
    "dropdown.background": "#0d0802",
    "list.hoverBackground": "#0d0802",
    "button.background": "#f8b00073",
    "errorForeground": "#ff817a",
    "editorError.foreground": "#ff817a",
    "terminal.ansiRed": "#ff817a",
    "editorWarning.foreground": "#f8b000",
    "terminal.ansiYellow": "#f8b000",
    "editorInfo.foreground": "#3fc3ff",
    "terminal.ansiBlue": "#3fc3ff",
    "terminal.ansiCyan": "#3fc3ff",
    "terminal.ansiGreen": "#3ce074",
    "terminal.ansiMagenta": "#f58eff",
    "gitDecoration.untrackedResourceForeground": "#3ce074",
    "gitDecoration.modifiedResourceForeground": "#f8b000",
    "gitDecoration.deletedResourceForeground": "#ff817a",
    "gitDecoration.conflictingResourceForeground": "#f58eff",
    "focusBorder": "#f8b000",
    "list.focusOutline": "#f8b000",
    "list.focusHighlightForeground": "#f8b000",
    "editorBracketMatch.border": "#3ce074",
    "editor.selectionBackground": "#3fc3ff4d",
    "list.activeSelectionBackground": "#3fc3ff4d",
    "list.inactiveSelectionBackground": "#3fc3ff4d",
    "editor.wordHighlightBackground": "#3fc3ff26",
    "editor.findMatchBackground": "#f8b00073",
    "editor.findMatchHighlightBackground": "#f8b00073",
    "editorBracketMatch.background": "#3ce07426"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#f8b000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#ff9300",
        "fontStyle": "bold"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#3fc3ff"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#f8b000"
      }
    },
    {
      "name": "interpolation",
      "scope": [
        "string.interpolated",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#00e5b6"
      }
    },
    {
      "name": "regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#00e2e5"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ff817a"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#f8b000"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#f8b000"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#00ceff"
      }
    },
    {
      "name": "interface",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#00e5b6"
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#f8b000"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#3ce074"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f8b000"
      }
    },
    {
      "name": "decorator",
      "scope": [
        "meta.decorator",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#f8b000"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#f58eff"
      }
    },
    {
      "name": "special var",
      "scope": [
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#f58eff"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff817a"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": {
      "foreground": "#3fc3ff"
    },
    "method": {
      "foreground": "#3fc3ff"
    },
    "function.declaration": {
      "foreground": "#3fc3ff",
      "bold": true
    },
    "method.declaration": {
      "foreground": "#3fc3ff",
      "bold": true
    },
    "variable": {
      "foreground": "#f8b000"
    },
    "parameter": {
      "foreground": "#f8b000"
    },
    "type": {
      "foreground": "#00ceff"
    },
    "class": {
      "foreground": "#00ceff"
    },
    "namespace": {
      "foreground": "#00ceff"
    },
    "enum": {
      "foreground": "#00ceff"
    },
    "interface": {
      "foreground": "#00e5b6"
    },
    "typeParameter": {
      "foreground": "#00e5b6"
    },
    "property": {
      "foreground": "#f8b000"
    }
  }
}
