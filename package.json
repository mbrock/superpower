{
  "name": "linen-glow",
  "displayName": "Linen Glow",
  "description": "Dark theme with semantic token background decorations for focus.",
  "version": "0.1.0",
  "publisher": "mbrock",
  "main": "./out/extension.js",
  "private": true,
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": ["Themes", "Other"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "linenGlow.createSuperpowerLauncher",
        "title": "Create Superpower Launcher (CDP)",
        "category": "Linen Glow"
      },
      {
        "command": "linenGlow.testCDP",
        "title": "Test CDP Connection",
        "category": "Linen Glow"
      }
    ],
    "themes": [
      {
        "label": "Linen Glow",
        "uiTheme": "vs-dark",
        "path": "./themes/linen-glow-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Linen Glow",
      "properties": {
        "linenGlow.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic token background decorations"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mbrock/conf"
  },
  "keywords": ["theme", "dark", "adhd", "focus", "semantic"],
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.0.0",
    "csstype": "^3.2.3",
    "monaco-editor": "^0.55.1",
    "prettier": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "build": "bun build ./src/extension.ts --outdir ./out --target=node --format=cjs --external=vscode --sourcemap=linked",
    "watch": "bun build ./src/extension.ts --outdir ./out --target=node --format=cjs --external=vscode --sourcemap=inline --watch",
    "format": "prettier --write src",
    "package": "bun run build && vsce package --allow-missing-repository"
  }
}
